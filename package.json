{
  "name": "concept-maker-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "icons": "tauri icon icon.png",
    "prepare:tauri-dev": "npm run icons && npm run build:backend && npm run dev:vite",
    "prepare:tauri-build": "npm run icons && npm run build:backend && npm run build:web",
    "build:backend": "node scripts/build-python-sidecar.mjs",
    "dev:vite": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1 --open",
    "build": "npm run build:web",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "markdown-it": "14.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
